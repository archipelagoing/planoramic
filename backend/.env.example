HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
DISPLAY_ORIGIN=http://localhost:8081
# Required: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local development controller only. Never embed this key in a published web app.
DEV_API_KEY=
# Google Web application OAuth client. See ../docs/google-calendar-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# Optional development-key account token only; browser OAuth refreshes its own tokens.
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
